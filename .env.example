# ──────────────────────────────────────────────
# UPSC Daily Affairs — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# For Docker:
#   docker compose up -d  # uses docker-compose.yml
#
# For Render:
#   Set these in the Render dashboard → Environment Variables.

# ── Backend ───────────────────────────────────

# Database URL
# ──────────────────────────────────────────────
# Local dev with Docker: leave unset (docker-compose sets DATABASE_URL automatically)
# Local dev without Docker (SQLite): leave unset — defaults to sqlite:///news.db
#
# Production with Render PostgreSQL:
#   Set DATABASE_URL to the internal connection string from your Render PostgreSQL
#   dashboard (created via New + → PostgreSQL). Use the Internal Database URL.
#
# DATABASE_URL=postgresql://upsc_daily_db_user:password@dpg-xxxxxxxx-a/upsc_daily_db

# Server Port (Render sets this via $PORT)
# Default: 8001
# PORT=8001

# API Key for auth on write endpoints (POST /pipeline/run, etc.)
# ──────────────────────────────────────────────
# If set, all POST endpoints require the X-API-Key header.
# If unset, all endpoints are open (safe for local dev, but lock down before
# deploying publicly).
# Generate one: openssl rand -hex 32
# API_KEY=

# CORS allowed origins
# ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In dev:  http://localhost:3000,http://127.0.0.1:3000
# In prod: https://your-frontend.vercel.app
# Default: * (allow all — change this for production!)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
# ──────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_FORMAT: text (human-readable, default) or json (for Datadog/CloudWatch/Logstash)
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# OpenRouter AI Playbooks
# ------------------------------------------------
# Required for UPSC exam playbook generation.
# Model is pinned in code to openrouter/owl-alpha.
# Owl Alpha is free to use, but OpenRouter free-tier request limits still apply.
# The provider may log prompts/completions for this model.
# OPENROUTER_API_KEY=
#
# Optional OpenRouter metadata headers (recommended in production)
# OPENROUTER_HTTP_REFERER=https://your-frontend.vercel.app
# OPENROUTER_APP_NAME=UPSC Daily Affairs
#
# Optional AI tuning / guardrails
# AI_MAX_COMPLETION_TOKENS=700
# AI_TEMPERATURE=0.2
# AI_MIN_REQUEST_INTERVAL_SECONDS=3.5
# AI_MAX_RETRIES=2
# AI_FREE_TIER_RUN_CAP=20

# ── Frontend ──────────────────────────────────

# Backend API URL (required)
# For local dev:   http://127.0.0.1:8001
# For Docker:      http://localhost:8001
# For production:  https://your-backend.onrender.com
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
